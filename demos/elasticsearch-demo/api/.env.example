# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# ".env" đã bị .gitignore — không commit credential thật lên git.

ELASTICSEARCH_URL=https://my-security-project-d8839b.es.ap-northeast-1.aws.elastic.cloud:443

# Cách 1 (khuyến nghị): API key — tạo ở Elastic Cloud Console > Security > API keys,
# hoặc Kibana Dev Tools: POST /_security/api_key {"name":"es-demo"}
# Dán nguyên giá trị "encoded" trả về (base64 của "id:api_key") vào đây.
ELASTICSEARCH_API_KEY=

# Cách 2: basic auth — bỏ trống ELASTICSEARCH_API_KEY ở trên nếu dùng cách này.
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=
